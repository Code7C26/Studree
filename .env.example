# Studree — Variables de entorno (template).
# Copiar a .env.local y completar los valores. NO commitear .env.local.
#
# ⚠️ En frontend, toda variable VITE_* es PÚBLICA (se incluye en el bundle).
#    NUNCA poner secretos (API keys privadas, tokens) aquí. Ver docs/03-security.md.

# Nombre visible de la app (opcional; default: "Studree")
VITE_APP_NAME=Studree
